generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  PRO
}

enum ContactStatus {
  NEW
  TO_CONTACT
  CONTACTED
  REPLIED
  INTERESTED
  MEETING
  CUSTOMER
  NOT_INTERESTED
}

enum Channel {
  EMAIL
  LINKEDIN
  SMS
  WHATSAPP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
  DISCARDED
  RECEIVED
}

enum RunType {
  FIND
  ENRICH
  DRAFT
  REPLY
}

enum RunStatus {
  RUNNING
  DONE
  FAILED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  plan        Plan     @default(FREE)
  // Ce que l'entreprise vend : sert de contexte a l'agent pour le ciblage et la redaction.
  offer       String   @default("")
  senderName  String   @default("")
  replyTo     String   @default("")
  signature   String   @default("")
  // Mention legale ajoutee au pied des e-mails (identite de l'expediteur).
  legalFooter String   @default("")
  createdAt   DateTime @default(now())

  memberships Membership[]
  invitations Invitation[]
  sessions    Session[]
  companies   Company[]
  contacts    Contact[]
  campaigns   Campaign[]
  runs        AgentRun[]
  messages    Message[]
  tasks       Task[]
  activities  Activity[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  sessions    Session[]
  tasks       Task[]
}

model Membership {
  id     String @id @default(cuid())
  role   Role   @default(MEMBER)
  userId String
  orgId  String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  orgId     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       Role      @default(MEMBER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Company {
  id           String    @id @default(cuid())
  orgId        String
  name         String
  website      String    @default("")
  domain       String    @default("")
  industry     String    @default("")
  city         String    @default("")
  size         String    @default("")
  description  String    @default("")
  phone        String    @default("")
  // Score de priorite 0-100 attribue par l'agent, avec sa justification.
  score        Int?
  scoreReason  String    @default("")
  // Elements d'accroche trouves par l'agent (actualites, signaux).
  insights     String    @default("")
  sourceUrl    String    @default("")
  tags         String[]  @default([])
  enrichedAt   DateTime?
  campaignId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  tasks      Task[]
  activities Activity[]

  @@index([orgId, name])
  @@index([orgId, domain])
}

model Contact {
  id               String        @id @default(cuid())
  orgId            String
  companyId        String?
  firstName        String        @default("")
  lastName         String        @default("")
  jobTitle         String        @default("")
  email            String        @default("")
  phone            String        @default("")
  linkedinUrl      String        @default("")
  status           ContactStatus @default(NEW)
  // RGPD : opposition a la prospection. Bloque tout envoi.
  doNotContact     Boolean       @default(false)
  unsubscribeToken String        @unique @default(cuid())
  // RGPD : d'ou vient la donnee.
  sourceUrl        String        @default("")
  notes            String        @default("")
  tags             String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  messages   Message[]
  tasks      Task[]
  activities Activity[]

  @@index([orgId, status])
  @@index([orgId, lastName])
  @@index([companyId])
}

model Campaign {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  // Cible (ICP)
  industry  String    @default("")
  location  String    @default("")
  size      String    @default("")
  roles     String    @default("")
  keywords  String    @default("")
  // Angle du message
  pitch     String    @default("")
  tone      String    @default("professionnel et direct")
  channels  Channel[] @default([EMAIL])
  createdAt DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companies Company[]
  runs      AgentRun[]
  messages  Message[]

  @@index([orgId])
}

model AgentRun {
  id           String    @id @default(cuid())
  orgId        String
  campaignId   String?
  type         RunType
  status       RunStatus @default(RUNNING)
  label        String    @default("")
  summary      String    @default("")
  error        String    @default("")
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}

model Message {
  id             String           @id @default(cuid())
  orgId          String
  contactId      String
  campaignId     String?
  channel        Channel
  direction      MessageDirection @default(OUTBOUND)
  status         MessageStatus    @default(DRAFT)
  subject        String           @default("")
  body           String
  // Rang dans la sequence : 1 = premier contact, 2+ = relances.
  step           Int              @default(1)
  aiGenerated    Boolean          @default(false)
  // Pour les reponses recues : categorie attribuee par l'agent.
  classification String           @default("")
  error          String           @default("")
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact  Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([contactId, createdAt])
}

model Task {
  id         String    @id @default(cuid())
  orgId      String
  contactId  String?
  companyId  String?
  assigneeId String?
  title      String
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact  Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company  Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([orgId, doneAt, dueAt])
}

model Activity {
  id        String   @id @default(cuid())
  orgId     String
  contactId String?
  companyId String?
  kind      String
  summary   String
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}
