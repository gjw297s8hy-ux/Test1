# Base PostgreSQL (Supabase, Neon, ou locale)
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm"

# Adresse publique de l'application (liens d'invitation et de desinscription)
APP_URL="http://localhost:3000"

# Adresses (separees par des virgules) dont l'espace a toujours acces a l'agent : la votre.
ADMIN_EMAILS=""

# Agent IA : cle API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# Modele utilise par l'agent (optionnel)
# ANTHROPIC_MODEL="claude-opus-5-5"

# Envoi des e-mails (optionnel). Sans SMTP, l'e-mail s'ouvre dans votre messagerie.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=""
# Adresse d'expedition autorisee par votre fournisseur SMTP
SMTP_FROM=""

# Envoi SMS / WhatsApp via Twilio (optionnel). Sans Twilio, envoi manuel.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
