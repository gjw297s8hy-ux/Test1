# Jeton du bot, donne par @BotFather
BOT_TOKEN=123456:ABC-votre-jeton

# Vos identifiants Telegram (admins), separes par des virgules. Obtenez le votre via @userinfobot
ADMIN_IDS=111111111

SHOP_NAME=Mon Auto Shop
# Devise d'affichage des prix : EUR ou USD
FIAT=EUR
# Contact affiche dans l'aide (optionnel)
SUPPORT=@votre_pseudo

# --- Adresses de reception. Laissez vide pour desactiver une monnaie. ---
# Paiement verifie automatiquement sur la blockchain :
WALLET_BTC=
WALLET_LTC=
WALLET_USDT_TRC20=

# Autres monnaies, validees a la main par un admin. Format : CODE:adresse,CODE:adresse
# Exemple : EXTRA_WALLETS=ETH:0xabc...,XMR:4abc...
EXTRA_WALLETS=

# Duree de validite d'une commande, en minutes
ORDER_TTL_MIN=60
# Confirmations blockchain exigees avant livraison (0 = des que la transaction apparait, risque)
MIN_CONFIRMATIONS=1
# Commandes en attente maximum par client (evite le blocage du stock)
MAX_PENDING=3

# Optionnel : cle TronGrid (https://www.trongrid.io) pour eviter les limites de debit en USDT
TRONGRID_API_KEY=

DB_PATH=shop.db
